<% layout("/layouts/boilerplate.ejs") %>

    <style>
        /* Wrapper for better control */
        .nice-select-wrapper {
            position: relative;
            width: 100%;
        }

        /* Select Box (datalist-like input) */
        .nice-select {
            width: 100%;
            padding: 12px 15px;
            border-radius: 12px;
            border: 2px solid #d0d0d0;
            background: #fff;
            font-size: 16px;
            font-weight: 500;
            appearance: none;
            /* Remove default arrow */
            cursor: pointer;
            transition: 0.3s ease;
            background-image: url("data:image/svg+xml;utf8,<svg fill='black' height='28' viewBox='0 0 24 24' width='28' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/></svg>");
            background-repeat: no-repeat;
            background-position: right 14px center;
        }

        .nice-select:focus {
            border-color: #6f42c1;
            box-shadow: 0 0 10px rgba(111, 66, 193, 0.25);
        }

        /* Option styling (best possible for browser support) */
        .nice-select option {
            font-size: 15px;
            padding: 10px;
        }

        /* Highlight selected */
        .nice-select option:checked {
            background-color: #f0e4ff !important;
            color: #6f42c1;
        }

        /* Chrome/Edge hover feel */
        .nice-select option:hover {
            background-color: #f3edff !important;
        }

        /* Make dropdown look smoother */
        select::-ms-expand {
            display: none;
        }
    </style>

    <div class="row mt-3">
        <div class="col-8 offset-2">

            <h3>Create New Listing!</h3>
            <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title:</label>
                    <input name="listing[title]" type="text" placeholder="enter title" class="form-control" id="title"
                        required>
                    <div class="valid-feedback">Title Looks good</div>
                </div>
                <!-- category imput using select -->
                <div class="container mt-3">
                    <label class="form-label">Select Category:</label>
                    <div class="nice-select-wrapper">
                        <select class="form-select nice-select" id="validationCustom04" name="listing[category]" required>
                            <option disabled selected value="">Select Category</option>
                            <option value="trending">Trending</option>
                            <option value="rooms">Rooms</option>
                            <option value="iconic cities">Iconic cities</option>
                            <option value="mountains">Mountains</option>
                            <option value="castles">Castles</option>
                            <option value="amazing pools">Amazing pools</option>
                            <option value="camping">Camping</option>
                            <option value="domes">Domes</option>
                            <option value="arctic">Arctic</option>
                            <option value="boats">Boats</option>
                        </select>
                        <div class="invalid-feedback">
                            Please select a valid state.
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="discription" class="form-label">discription:</label>
                    <textarea id="discription" name="listing[discription]" type="text" placeholder=""
                        class="form-control" required></textarea>
                    <div class="invalid-feedback">Please enter short description</div>
                </div>
                <div class="mb-3">
                    <label for="img" class="form-label">Upload Image:</label>
                    <input id="img" name="listing[image]" type="file" class="form-control" required>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price:</label>
                        <input id="price" name="listing[price]" type="number" placeholder="12,000" class="form-control"
                            required>
                        <div class="invalid-feedback">Price should be valid</div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="location" class="form-label">Location:</label>
                        <input id="location" name="listing[location]" type="text" placeholder="Jaipur, rajsthan"
                            class="form-control" required>
                        <div class="invalid-feedback">Location should be valid</div>
                    </div>
                </div>


                <div class="mb-3">
                    <label for="country" class="form-label">Country:</label>
                    <input id="country" name="listing[country]" type="text" placeholder="India" class="form-control"
                        required>
                    <div class="invalid-feedback">Country name should be valid</div>
                </div>
                <br><br>

                <button class="btn btn-dark">Add Listing</button>
            </form>
        </div>
    </div>