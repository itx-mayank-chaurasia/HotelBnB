<style>
  /* nav search options */
  .search-btn {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }

  .search-btn i {
    display: inline;
    margin-right: 0.5rem;
  }

  .search-btn:hover {
    background-color: #fe424d;
    color: #fff;
  }

  .search-inp {
    background-color: #eee;
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
    min-width: 150px;
  }
</style>
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="#"><i class="fa-brands fa-airbnb"></i></a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <!-- <a class="nav-link" href="/">Home</a> -->
        <a class="nav-link" href="/listings">Explore</a>

      </div>
    </div>
    <form class="d-flex search ms-auto needs-validation" role="search"  action="/listings/search" method="get" novalidate>
      <input class="form-control me-2 search-inp" type="search" name="query" placeholder="Search destinations" aria-label="Search" required />
      <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
    </form>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      
      <!-- <div class="ms-auto"> -->

      <!-- </div> -->
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Airbnb you home</a>
        <% if(!currUser){ %>
          <a class="nav-link" href="/signup"><b>Signup</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
          <% }else{ %>

            <a class="nav-link" href="/logout"><b>Logout</b></a>
            <% } %>
      </div>
    </div>
  </div>
</nav>
<script>
  let searchBtn = document.querySelector('.search-btn');
  let searchInp = document.querySelector('.search-inp');
  searchBtn.addEventListener("click", () => {
    searchInp.Value = "";
  })
</script>