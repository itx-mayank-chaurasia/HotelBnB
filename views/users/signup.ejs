<% layout("/layouts/boilerplate.ejs") %>

    <div class="row mt-3">
        <div class="col-6 offset-3">

            <h3>SignUp for Wanderlust</h3>
            <form action="/signup" method="post" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username:</label>
                    <input name="username" type="text" placeholder="Enter Username" class="form-control" id="username"
                        required>
                    <div class="valid-feedback">Looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email:</label>
                    <input name="email" type="email" placeholder="Enter Email" class="form-control" id="email"
                        required>
                    <div class="invalid-feedback">Email is required</div>
                </div>
                <div class="mb-3">
                    <label for="Password" class="form-label">Password:</label>
                    <input name="password" type="password" placeholder="Enter Password" class="form-control" id="password"
                        required>
                    <div class="invalid-feedback">Please Enter Password </div>
                </div>
                <div>Already Have An Account <a class="userLink" href="/login">Login</a></div>
                <button class="btn btn-success">SignUp</button>
            </form>
        </div>
    </div>